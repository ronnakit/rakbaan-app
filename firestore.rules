rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      // custom claim ต้องตั้งผ่าน Admin SDK เท่านั้น — client ไม่มีทางแก้ค่านี้เอง
      // ต้องใช้ .get(key, default) ไม่ใช่ .role ตรงๆ -- ผู้ใช้ที่ยังไม่มี custom
      // claim นี้เลย (เช่น anonymous auth ก่อนมีระบบตั้ง role จริง) จะทำให้
      // request.auth.token.role throw error แทนที่จะ return null อย่างที่คาดไว้
      // ทำให้ทุก || chain ที่เรียก role() ผ่าน isAdmin()/isTeamOrAdmin() พังไปด้วย
      // แม้ clause หลังๆที่ควรจะอนุญาตอยู่แล้วก็ตาม (เจอบั๊กจริงตอนทดสอบ 2026-08-11
      // -- ลูกค้า anonymous อ่าน addresses/jobs ของตัวเองไม่ได้เลยเพราะเหตุนี้)
      return isSignedIn() ? request.auth.token.get('role', 'customer') : 'anonymous';
    }

    function isTeamOrAdmin() {
      return role() == 'team' || role() == 'admin' || role() == 'super_admin';
    }

    function isAdmin() {
      return role() == 'admin' || role() == 'super_admin';
    }

    function isSuperAdmin() {
      return role() == 'super_admin';
    }

    // ระดับการมองเห็นตาม recordStatus (rakbaan_md/12-database-structure-front-end.md §1.5.1)
    // -- ต้องส่ง ownerId มาเช็คด้วยเสมอ ไม่ใช่แค่ recordStatus: เดิม (ก่อน 2026-08-11
    // รอบ 2) ไม่มีการเช็ค ownership เลยในระดับ "signed-in ทั่วไป" ทำให้ลูกค้าคนหนึ่ง
    // อ่านของลูกค้าคนอื่นที่ recordStatus<=1 ได้หมด ถ้ารู้ doc id หรือ query แบบอื่น
    function canRead(data, ownerId) {
      // .get(key, default) แทนการเข้าถึง data.recordStatus ตรงๆ ด้วยเหตุผลเดียวกับ
      // role() ด้านบน -- list query ยังพังแม้แก้ role() แล้ว เพราะ data.recordStatus
      // ตรงๆ throw ได้เหมือนกันตอน Firestore ประเมิน rule แบบ speculative สำหรับ
      // list request (ยืนยันจากการทดสอบจริง 2026-08-11: isSignedIn() เฉยๆผ่าน,
      // แต่ canRead() เดิมพังแม้ collection ว่างเปล่า)
      return isSuperAdmin()
        || (isAdmin() && data.get('recordStatus', 0) <= 4)
        || (isTeamOrAdmin() && data.get('recordStatus', 0) <= 3)
        || (isSignedIn() && request.auth.uid == ownerId && data.get('recordStatus', 0) <= 1);
    }

    // self-delete: เจ้าของเปลี่ยน 0 -> 3 เท่านั้น, lastActorId/Type ต้องตรงกับตัวเอง,
    // ห้ามแก้ field อื่นในทรานแซกชันเดียวกัน (ป้องกันการแอบเปลี่ยนข้อมูลพร้อมลบ)
    function isSelfDeleteTransition(ownerId) {
      return isSignedIn()
        && request.auth.uid == ownerId
        && resource.data.recordStatus == 0
        && request.resource.data.recordStatus == 3
        && request.resource.data.lastActorId == request.auth.uid
        && request.resource.data.lastActorType == 'customer'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['recordStatus', 'lastActorId', 'lastActorType']);
    }

    // ปฏิเสธการเขียน recordStatus ตรงจาก client ทุกกรณี ยกเว้น self-delete (0->3)
    // — transition อื่นทั้งหมดต้องผ่าน Cloud Function (Admin SDK bypass rules อยู่แล้ว)
    function isProtectedStatusWrite() {
      return request.resource.data.recordStatus != resource.data.recordStatus
        && !(resource.data.recordStatus == 0 && request.resource.data.recordStatus == 3);
    }

    // milestones v3 (2026-08-12) -- ลูกค้าทำเครื่องหมาย "อ่านแล้ว" งวดงานได้ ไม่จำกัดสถานะ
    // (การดูข้อมูลตัวเองไม่มีความเสี่ยง) แต่ต้องแก้แค่ readAt field เดียวเท่านั้น
    function isCustomerMilestoneRead(jobCustomerId) {
      return isSignedIn()
        && request.auth.uid == jobCustomerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
    }

    // milestones v3 (2026-08-12) -- ลูกค้ายืนยันรับงวดงาน: completed -> approved เท่านั้น
    // (ห้าม approve งวดที่ช่างยังไม่แจ้งเสร็จ) พร้อม remark ของตัวเอง lastActorId/Type ต้อง
    // เป็นของตัวเองเสมอ (เหมือน isSelfDeleteTransition) ห้ามแก้ amount/retention/ฟิลด์อื่นแอบไปด้วย
    function isCustomerMilestoneConfirm(jobCustomerId) {
      return isSignedIn()
        && request.auth.uid == jobCustomerId
        && resource.data.status == 'completed'
        && request.resource.data.status == 'approved'
        && request.resource.data.lastActorId == request.auth.uid
        && request.resource.data.lastActorType == 'customer'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'approvedAt', 'customerRemark', 'lastActorId', 'lastActorType']);
    }

    // ---------- Group A: users ----------
    match /users/{userId} {
      allow read: if canRead(resource.data, userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSelfDeleteTransition(userId)
        || (isSignedIn() && request.auth.uid == userId && !isProtectedStatusWrite())
        || (isTeamOrAdmin() && !isProtectedStatusWrite());
      allow delete: if false; // ห้าม hard-delete จาก client เด็ดขาด
    }

    // ---------- Group A: addresses ----------
    match /addresses/{addressId} {
      allow read: if canRead(resource.data, resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSelfDeleteTransition(resource.data.userId)
        || (isSignedIn() && request.auth.uid == resource.data.userId && !isProtectedStatusWrite())
        || (isTeamOrAdmin() && !isProtectedStatusWrite());
      allow delete: if false;
    }

    // ---------- Group A: jobs (+ sub-collections) ----------
    match /jobs/{jobId} {
      allow read: if canRead(resource.data, resource.data.customerId);
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isSelfDeleteTransition(resource.data.customerId)
        || (isTeamOrAdmin() && !isProtectedStatusWrite());
      allow delete: if false;

      match /boq_items/{boqId} {
        allow read: if canRead(
          get(/databases/$(database)/documents/jobs/$(jobId)).data,
          get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId
        );
        allow write: if isTeamOrAdmin() && !isProtectedStatusWrite();
      }
      match /milestones/{milestoneId} {
        allow read: if canRead(
          get(/databases/$(database)/documents/jobs/$(jobId)).data,
          get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId
        );
        allow create: if isTeamOrAdmin() && !isProtectedStatusWrite();
        // v3 (2026-08-12): ลูกค้าเขียนได้ 2 ทางแบบจำกัดมากเท่านั้น -- (1) ทำเครื่องหมาย
        // "อ่านแล้ว" (2) ยืนยันรับงวดงาน (completed -> approved) พร้อม remark ของตัวเอง
        // ทุก field อื่น (amount/retention/startedAt/technicianRemark ฯลฯ) ยังเขียนได้แค่ team/admin เท่านั้น
        allow update: if isCustomerMilestoneRead(
            get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId
          )
          || isCustomerMilestoneConfirm(
            get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId
          )
          || (isTeamOrAdmin() && !isProtectedStatusWrite());
        allow delete: if false;
      }
      match /status_history/{historyId} {
        // กลุ่ม C — append-only, เขียนได้จาก Cloud Function (Admin SDK) เท่านั้น
        allow read: if canRead(
          get(/databases/$(database)/documents/jobs/$(jobId)).data,
          get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId
        );
        allow write: if false;
      }
      match /photos/{photoId} {
        // ดู rakbaan_md/12-database-structure-front-end.md §2.18 job_photos
        allow read: if canRead(
          get(/databases/$(database)/documents/jobs/$(jobId)).data,
          get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId
        );
        allow create: if isSignedIn() &&
          (get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId == request.auth.uid || isTeamOrAdmin());
        allow update: if isSelfDeleteTransition(resource.data.uploadedBy) || (isTeamOrAdmin() && !isProtectedStatusWrite());
        allow delete: if false;
      }
    }

    // ---------- Group A: chat_sessions (+ messages) ----------
    match /chat_sessions/{sessionId} {
      allow read: if canRead(resource.data, resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSelfDeleteTransition(resource.data.userId)
        || (isTeamOrAdmin() && !isProtectedStatusWrite());
      allow delete: if false;

      match /messages/{messageId} {
        // กลุ่ม C — immutable, ไม่มี recordStatus, ลบทั้ง session แทน
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.userId == request.auth.uid || isTeamOrAdmin());
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---------- Group A: memberships, reviews, notifications, disputes, escrow_transactions ----------
    match /memberships/{membershipId} {
      allow read: if canRead(resource.data, resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSelfDeleteTransition(resource.data.userId) || (isTeamOrAdmin() && !isProtectedStatusWrite());
      allow delete: if false;
    }

    // v2.1 (2026-08-12): ให้คะแนนได้ 2 ทาง (raterRole = 'customer' | 'technician')
    // reviewId ต้องเป็น "{jobId}_{raterRole}" เสมอ -- บังคับให้คะแนนได้ครั้งเดียวต่องาน
    // ต่อทิศทางโดยไม่ต้อง query ก่อนเขียน: ถ้า doc นี้มีอยู่แล้ว การเขียนซ้ำจะถูกตีความเป็น
    // "update" (ไม่ใช่ "create") ซึ่ง allow update ด้านล่างไม่อนุญาตให้ resubmit เอง จึงติดอัตโนมัติ
    // ⚠️ ข้อจำกัดที่รู้ตัว: customerId/technicianId เชื่อค่าที่ client ส่งมาตรงๆ ไม่ได้ cross-check
    // กับ jobs.assignedTeamId เพราะยังไม่มีระบบยืนยันตัวช่างรายบุคคล (ทีมช่าง vs ช่างคนเดียว
    // ยังไม่ได้ออกแบบ -- รอเว็บ Ops-Portal) เหมือนกับฝั่งลูกค้าเดิมที่ก็ไม่เคย cross-check เช่นกัน
    match /reviews/{reviewId} {
      allow read: if canRead(resource.data, resource.data.customerId)
        || canRead(resource.data, resource.data.technicianId);
      allow create: if isSignedIn()
        && request.resource.data.raterRole in ['customer', 'technician']
        && reviewId == request.resource.data.jobId + '_' + request.resource.data.raterRole
        && (
          (request.resource.data.raterRole == 'customer' && request.resource.data.customerId == request.auth.uid)
          || (request.resource.data.raterRole == 'technician' && request.resource.data.technicianId == request.auth.uid)
        );
      allow update: if isSelfDeleteTransition(
          resource.data.raterRole == 'customer' ? resource.data.customerId : resource.data.technicianId
        )
        || (isTeamOrAdmin() && !isProtectedStatusWrite());
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if canRead(resource.data, resource.data.userId);
      allow create: if isTeamOrAdmin(); // ระบบ/แอดมินสร้างแจ้งเตือน ไม่ใช่ผู้ใช้เอง
      allow update: if isSelfDeleteTransition(resource.data.userId) || (isTeamOrAdmin() && !isProtectedStatusWrite());
      allow delete: if false;
    }

    match /disputes/{disputeId} {
      allow read: if canRead(resource.data, resource.data.raisedBy);
      allow create: if isSignedIn() && request.resource.data.raisedBy == request.auth.uid;
      allow update: if isTeamOrAdmin() && !isProtectedStatusWrite(); // ลูกค้าเปิดเคสได้ แต่ปิด/แก้สถานะเองไม่ได้
      allow delete: if false;
    }

    match /escrow_transactions/{transactionId} {
      // การเงิน — client อ่านได้เท่านั้น ห้ามเขียน/แก้เองแม้แต่ self-delete
      allow read: if canRead(resource.data, resource.data.customerId) || isTeamOrAdmin();
      allow write: if false; // เขียนได้จาก Cloud Function (Admin SDK, เชื่อม PG webhook) เท่านั้น
    }

    // ---------- Group B: master/reference data (ไม่มี recordStatus) ----------
    match /price_lists/{itemId}  { allow read: if true; allow write: if isAdmin(); }
    match /promotions/{promoId}  { allow read: if true; allow write: if isAdmin(); }
    match /cost_codes/{codeId}   { allow read: if isTeamOrAdmin(); allow write: if isAdmin(); }

    // ---------- Group C: immutable audit trail ----------
    match /consent_logs/{consentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /user_activity_logs/{logId}   { allow read: if isAdmin(); allow write: if false; }
    match /revenue_transactions/{txId}  { allow read: if isAdmin(); allow write: if false; }
    match /audit_logs/{logId}           { allow read: if isAdmin(); allow write: if false; }
    match /database_edit_log/{logId}    { allow read: if isAdmin(); allow write: if false; }
  }
}
